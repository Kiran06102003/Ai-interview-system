# ================================================================
# AI Interview System — Environment Variables
# Copy this file to .env in the /server directory and fill values
# ================================================================

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/ai-interview
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai-interview
MONGODB_URI=mongodb://localhost:27017/ai-interview

# ── JWT ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=jLp0K5qhrmNMEXAMtmZptxYp4pT0IcevwnMJdsFbh8t 
JWT_EXPIRES_IN=7d

# ── OpenAI ────────────────────────────────────────────────────────
# Required: used for GPT-4o-mini (questions + analysis), Whisper (STT), TTS fallback
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── ElevenLabs (Optional — falls back to OpenAI TTS if not set) ───
# Get key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ── Client URL (CORS) ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
